{
  "name": "neoglassrojo-belentani-wheel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NeoGlassRojo Belentani Wheel — rueda de decisión neumórfica sobre WebGL2, con fallback Canvas 2D, física de giro verificada y accesibilidad completa.",
  "license": "MIT",
  "author": "Belentani",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "node --import tsx scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run lint:html && npm run check:shaders && npm run test:coverage && npm run build && npm run report",
    "report": "node --import tsx scripts/report.mjs",
    "wheel": "node --import tsx scripts/wheel-cli.mjs",
    "check:shaders": "node --import tsx scripts/check-shaders.mjs",
    "lint:html": "html-validate \"index.html\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "glslang-validator-prebuilt-predownloaded": "^0.0.2",
    "html-validate": "^11.22.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
